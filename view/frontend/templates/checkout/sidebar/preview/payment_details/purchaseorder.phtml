<?php declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\PurchaseOrder\Component\Checkout\Billing\PaymentMethod\PurchaseOrderViewModel;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var PurchaseOrderViewModel $viewModel */

$poNumber = $viewModel->getValue();
if (empty($poNumber)) {
    return '';
} ?>
<div>
    <span><?= $escaper->escapeHtml(__('PO Number')) ?></span>:
    <?= $escaper->escapeHtml($poNumber) ?>
</div>
